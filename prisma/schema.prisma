// Esquema de base de datos de Hathor Frequency (PostgreSQL).
// Tablas para los formularios de la landing: Contacto y Reservar.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Servicios que se pueden reservar (mismos que src/data/booking.ts)
enum Service {
  GRABACION     @map("grabacion")
  MEZCLA        @map("mezcla")
  MASTERIZACION @map("masterizacion")
  VIDEO         @map("video")
  LIVE_SESSIONS @map("live_sessions")

  @@map("service")
}

enum BookingStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  CANCELLED @map("cancelled")
  /// El admin la marcó como terminada (cuenta en las cifras de "Proyectos")
  COMPLETED @map("completed")

  @@map("booking_status")
}

/// Representante de la reserva: alguien de la banda o una persona externa (mánager, productor…)
enum RepresentativeType {
  INTEGRANTE @map("integrante")
  EXTERNO    @map("externo")

  @@map("representative_type")
}

/// Correos enviados desde la sección Contacto
model ContactRequest {
  id        String    @id @default(uuid()) @db.Uuid
  /// Nombre de quien pide la información
  name      String    @db.VarChar(120)
  /// Tema sobre el que pide información (src/data/site.ts · contactTopics)
  topic     String    @db.VarChar(40)
  email     String    @db.VarChar(254)
  /// Teléfono para que el asesor llame (desde el 2026-10-12; los anteriores no lo tienen)
  phone     String?   @db.VarChar(20)
  /// Cuándo lo marcó como atendido el estudio (panel · Contactos); null = sin atender
  handledAt DateTime? @map("handled_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([email])
  @@map("contact_requests")
}

/// Solicitudes de sesión desde la sección Reservar
model Booking {
  id                 String             @id @default(uuid()) @db.Uuid
  /// Día de la sesión (sin hora)
  date               DateTime           @db.Date
  /// Hora de inicio "HH:MM" (las de panel · Contenido · Horarios)
  startTime          String             @map("start_time") @db.VarChar(5)
  service            Service
  status             BookingStatus      @default(PENDING)
  /// Nombre de la banda o proyecto
  project            String             @db.VarChar(120)
  representativeType RepresentativeType @map("representative_type")
  representativeName String             @map("representative_name") @db.VarChar(120)
  phone              String             @db.VarChar(20)
  /// Vacío si la sesión la agendó el estudio sin correo
  email              String             @db.VarChar(254)
  /// Monto acordado en centavos MXN (se captura al confirmar en el panel)
  amountCents        Int?               @map("amount_cents")
  paymentStatus      PaymentStatus      @default(PENDING) @map("payment_status")
  /// Anticipo recibido en centavos MXN (paymentStatus = DEPOSIT)
  depositCents       Int?               @map("deposit_cents")
  /// Cuándo quedó pagada por completo
  paidAt             DateTime?          @map("paid_at") @db.Timestamptz(6)
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([date])
  @@map("bookings")
}

/// Cobro de una reserva: pendiente, con anticipo o pagada
enum PaymentStatus {
  PENDING @map("pending")
  DEPOSIT @map("deposit")
  PAID    @map("paid")

  @@map("payment_status")
}

enum ReviewStatus {
  PENDING   @map("pending")
  PUBLISHED @map("published")
  REJECTED  @map("rejected")

  @@map("review_status")
}

/// Opiniones de la ventana "Deja tu opinión"; se publican solo después de revisarlas
model Review {
  id        String       @id @default(uuid()) @db.Uuid
  /// 1 a 5 estrellas
  rating    Int          @db.SmallInt
  name      String       @db.VarChar(120)
  /// Banda o proyecto (opcional)
  project   String?      @db.VarChar(120)
  service   String       @db.VarChar(40)
  text      String       @db.VarChar(500)
  /// Autorizó publicarla con su nombre
  consent   Boolean      @default(false)
  status    ReviewStatus @default(PENDING)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([status])
  @@map("reviews")
}

/// Días u horarios que el estudio cierra desde el panel (no se pueden reservar)
model BlockedSlot {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime @db.Date
  /// Hora "HH:MM"; null = el día completo
  startTime String?  @map("start_time") @db.VarChar(5)
  reason    String?  @db.VarChar(120)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([date])
  @@map("blocked_slots")
}

/// Personas del estudio con acceso al panel (alta con `npm run admin:create`)
model AdminUser {
  id                  String               @id @default(uuid()) @db.Uuid
  /// Con lo que entra al panel: inicial del primer nombre + primer apellido ("jnunez", "jnunez2"); sin correo
  username            String               @unique @db.VarChar(60)
  /// Nombre completo (se arma con los cuatro campos)
  name                String               @db.VarChar(120)
  firstName           String               @default("") @map("first_name") @db.VarChar(60)
  middleName          String?              @map("middle_name") @db.VarChar(60)
  lastName            String               @default("") @map("last_name") @db.VarChar(60)
  secondLastName      String?              @map("second_last_name") @db.VarChar(60)
  phone               String?              @db.VarChar(20)
  /// Fecha de nacimiento: ese día la web festeja su cumpleaños (temporada `cumple`); la web solo recibe el nombre
  birthDate           DateTime?            @map("birth_date") @db.Date
  /// scrypt: "salt:hash" en hex
  passwordHash        String               @map("password_hash") @db.VarChar(200)
  /// Contraseña temporal, cifrada con APP_SECRET (AES-GCM): el principal la ve hasta que la persona pone la suya; null después
  tempPassword        String?              @map("temp_password") @db.VarChar(300)
  /// Debe cambiar su contraseña (usuario nuevo o con temporal): la pantalla de bienvenida se lo pide
  mustChangePassword  Boolean              @default(false) @map("must_change_password")
  /// Guías del panel que ya vio ("agenda", "inicio"…): la de cada módulo sale sola solo la primera vez
  guidesSeen          String[]             @default([]) @map("guides_seen")
  /// Usuario principal (ROOT_ADMIN_EMAIL): siempre existe, no se puede borrar y es el único que administra usuarios
  isRoot              Boolean              @default(false) @map("is_root")
  /// Qué ve en el panel: ADMIN todo; STAFF solo Agenda, Contactos y Mi cuenta (el principal siempre es ADMIN)
  role                AdminRole            @default(ADMIN)
  /// Intentos fallidos seguidos; al llegar a 5 la cuenta se bloquea 15 min (vengan de la IP que vengan)
  failedLogins        Int                  @default(0) @map("failed_logins")
  lockedUntil         DateTime?            @map("locked_until") @db.Timestamptz(6)
  createdAt           DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  sessions            AdminSession[]
  loginEvents         AdminLoginEvent[]
  dedicationsReceived BirthdayDedication[] @relation("recipient")
  dedicationsWritten  BirthdayDedication[] @relation("author")

  @@map("admin_users")
}

/// Rol de un usuario del panel
enum AdminRole {
  ADMIN @map("admin")
  STAFF @map("staff")

  @@map("admin_role")
}

/// Sesión del panel; solo se guarda el hash del token de la cookie
model AdminSession {
  id         String    @id @default(uuid()) @db.Uuid
  tokenHash  String    @unique @map("token_hash") @db.VarChar(64)
  userId     String    @map("user_id") @db.Uuid
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Vence a los 7 días aunque se use; sin uso, a las 12 h de `lastSeenAt`
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(6)
  lastSeenAt DateTime  @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  ip         String?   @db.VarChar(64)
  userAgent  String?   @map("user_agent") @db.VarChar(300)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([userId])
  @@map("admin_sessions")
}

/// Dedicatoria de cumpleaños (panel): alguien del equipo firma la "funda" de quien cumple ese día (D2) y quien cumple
/// las lee una a una (L1). Solo la lee quien la recibe; el resto del equipo solo ve quién firmó.
model BirthdayDedication {
  id          String    @id @default(uuid()) @db.Uuid
  recipientId String    @map("recipient_id") @db.Uuid
  recipient   AdminUser @relation("recipient", fields: [recipientId], references: [id], onDelete: Cascade)
  authorId    String    @map("author_id") @db.Uuid
  author      AdminUser @relation("author", fields: [authorId], references: [id], onDelete: Cascade)
  /// Día del cumpleaños (CDMX) al que pertenece
  forDate     DateTime  @map("for_date") @db.Date
  text        String    @db.VarChar(500)
  /// Se firma como "Anónimo"
  anonymous   Boolean   @default(false)
  /// Cuándo la leyó quien cumple (null = nueva)
  readAt      DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([recipientId, authorId, forDate])
  @@index([recipientId, forDate])
  @@map("birthday_dedications")
}

/// Registro de accesos al panel: cada intento de login, bueno o fallido (se guardan 90 días)
model AdminLoginEvent {
  id        String     @id @default(uuid()) @db.Uuid
  /// El usuario que se escribió en el login (puede no existir)
  username  String     @db.VarChar(254)
  userId    String?    @map("user_id") @db.Uuid
  user      AdminUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  success   Boolean
  /// Por qué falló: "password", "unknown" (correo sin cuenta) o "locked"
  reason    String?    @db.VarChar(20)
  ip        String?    @db.VarChar(64)
  userAgent String?    @map("user_agent") @db.VarChar(300)
  createdAt DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt])
  @@index([userId])
  @@map("admin_login_events")
}

/// Modo mantenimiento de la web completa (una sola fila, id = 1). Se aplica al instante, sin borrador:
/// la web muestra la pantalla de mantenimiento y los formularios responden 503. El panel sigue funcionando.
model SiteMaintenance {
  id            Int       @id @default(1)
  enabled       Boolean   @default(false)
  /// Mensaje para los visitantes (vacío = el texto por defecto)
  message       String?   @db.VarChar(300)
  /// Regreso estimado que se muestra ("Volvemos hoy a las 6:00 p. m."); no la vuelve a encender sola
  until         DateTime? @db.Timestamptz(6)
  startedAt     DateTime? @map("started_at") @db.Timestamptz(6)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByName String?   @map("updated_by_name") @db.VarChar(120)

  @@map("site_maintenance")
}

/// Borrador de módulos apagados del panel · Sitio (una sola fila, id = 1)
model SiteDraft {
  id            Int      @id @default(1)
  /// Ids de src/data/modules.ts que están apagados
  disabled      String[]
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByName String?  @map("updated_by_name") @db.VarChar(120)

  @@map("site_draft")
}

/// Cada publicación del panel · Sitio; la más reciente es la que ve el público
model SiteVersion {
  id              String   @id @default(uuid()) @db.Uuid
  disabled        String[]
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByName String   @map("published_by_name") @db.VarChar(120)

  @@index([publishedAt])
  @@map("site_versions")
}

/// Borrador de una sección del panel · Contenido (una fila por sección)
model ContentDraft {
  /// Sección: servicios, paquetes, precios, artistas, faq, estudio, sitio (src/data/content.ts)
  key           String   @id @db.VarChar(40)
  data          Json
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  updatedByName String?  @map("updated_by_name") @db.VarChar(120)

  @@map("content_drafts")
}

/// Cada publicación de una sección; la más reciente de cada `key` es la que ve el público
model ContentVersion {
  id              String   @id @default(uuid()) @db.Uuid
  key             String   @db.VarChar(40)
  data            Json
  /// Resumen de qué cambió respecto a la versión anterior (para el historial)
  summary         String   @db.VarChar(500)
  publishedAt     DateTime @default(now()) @map("published_at") @db.Timestamptz(6)
  publishedByName String   @map("published_by_name") @db.VarChar(120)

  @@index([key, publishedAt])
  @@map("content_versions")
}
