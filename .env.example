# Copia este archivo a .env si necesitas cambiar los valores por defecto.
# docker-compose.yml ya trae estos mismos defaults, así que .env es opcional.

POSTGRES_USER=hathor
POSTGRES_PASSWORD=hathor
POSTGRES_DB=hathor_frequency

# Puertos publicados en el host
APP_PORT=5173
DB_PORT=5440

# Para correr Prisma desde el host (fuera de Docker) contra la base del compose
DATABASE_URL="postgresql://hathor:hathor@localhost:5440/hathor_frequency?schema=public"
