# Copia este archivo a .env si necesitas cambiar los valores por defecto.
# docker-compose.yml ya trae estos mismos defaults, así que .env es opcional.

POSTGRES_USER=hathor
POSTGRES_PASSWORD=hathor
POSTGRES_DB=hathor_frequency

# Puertos publicados en el host
APP_PORT=5173
DB_PORT=5440

# API (Hono, server/). Vite la sirve en /api con un proxy; no se publica en el host
API_PORT=3000

# Para correr Prisma desde el host (fuera de Docker) contra la base del compose
DATABASE_URL="postgresql://hathor:hathor@localhost:5440/hathor_frequency?schema=public"

# Umami (visitas). Panel de Umami: http://localhost:3100 (primer acceso admin / umami: cámbialo)
UMAMI_PORT=3100
# ID del sitio creado en Umami: lo usan la API (dashboard) y el script del sitio
UMAMI_WEBSITE_ID=
VITE_UMAMI_WEBSITE_ID=
UMAMI_USERNAME=admin
UMAMI_PASSWORD=umami
# Desde el host (npm run dev:all) Vite y la API llegan a Umami por el puerto publicado
UMAMI_URL=http://localhost:3100
UMAMI_PROXY_TARGET=http://localhost:3100
