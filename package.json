{
  "name": "hathor-frequency",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:panel": "vite -c vite.panel.config.ts",
    "dev:web-api": "tsx watch server/web/index.ts",
    "dev:panel-api": "tsx watch server/panel/index.ts",
    "dev:web-all": "concurrently -k -n web,web-api -c yellow,cyan \"npm:dev\" \"npm:dev:web-api\"",
    "dev:panel-all": "concurrently -k -n panel,panel-api -c magenta,blue \"npm:dev:panel\" \"npm:dev:panel-api\"",
    "dev:all": "concurrently -k -n web,web-api,panel,panel-api -c yellow,cyan,magenta,blue \"npm:dev\" \"npm:dev:web-api\" \"npm:dev:panel\" \"npm:dev:panel-api\"",
    "build": "tsc -b && vite build && vite build -c vite.panel.config.ts",
    "lint": "oxlint",
    "preview": "vite preview",
    "preview:panel": "vite preview -c vite.panel.config.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "prisma db seed",
    "admin:create": "tsx server/panel/scripts/create-admin.ts",
    "admin:reset-2fa": "tsx server/panel/scripts/reset-2fa.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.4",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "hono": "^4.13.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.6",
    "dotenv": "^18.0.6",
    "oxlint": "^1.81.0",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
